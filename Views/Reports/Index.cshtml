@{
    ViewData["Title"] = "Reports";
}

<div class="container-fluid px-0">
    <h2 class="mb-4">Reports</h2>

    <!-- Navigation tabs for Reports page -->
    <ul class="nav nav-tabs mb-3" id="reportsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="generate-reports-tab" data-bs-toggle="tab" data-bs-target="#generate-reports" type="button" role="tab">Generate Reports</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="dashboards-tab" data-bs-toggle="tab" data-bs-target="#dashboards" type="button" role="tab">Dashboards</button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Generate Reports Tab -->
        <div class="tab-pane fade show active" id="generate-reports" role="tabpanel">
            <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Filter Options</h4>
        </div>
        <div class="card-body">
            <form id="reportForm" asp-action="GenerateReport" method="post">
                <div class="row g-3">
                    <!-- Academic Standing -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="academicStanding" class="form-label">Academic Standing</label>
                        <select class="form-select" id="academicStanding" name="academicStanding">
                            <option value="">All</option>
                            <option value="Freshman">Freshman</option>
                            <option value="Sophomore">Sophomore</option>
                            <option value="Junior">Junior</option>
                            <option value="Senior">Senior</option>
                            <option value="Graduate Student">Graduate Student</option>
                        </select>
                    </div>

                    <!-- Eligibility -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="eligibility" class="form-label">Eligibility</label>
                        <select class="form-select" id="eligibility" name="eligibility">
                            <option value="">All</option>
                            <option value="First Generation">First Generation</option>
                            <option value="Low Income">Low Income</option>
                            <option value="Disability">Disability</option>
                        </select>
                    </div>

                    <!-- Ethnicity -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="ethnicity" class="form-label">Ethnicity</label>
                        <select class="form-select" id="ethnicity" name="ethnicity">
                            <option value="">All</option>
                            <option value="Hispanic/Latino">Hispanic/Latino</option>
                            <option value="White">White</option>
                            <option value="Black or African American">Black or African American</option>
                            <option value="Asian">Asian</option>
                            <option value="American Indian">American Indian</option>
                            <option value="Native Hawaiian/Pacific Islander">Native Hawaiian/Pacific Islander</option>
                        </select>
                    </div>

                    <!-- Gender -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="gender" class="form-label">Gender</label>
                        <select class="form-select" id="gender" name="gender">
                            <option value="">All</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Non-binary">Non-binary</option>
                            <option value="Prefer not to say">Prefer not to say</option>
                        </select>
                    </div>

                    <!-- Batch Year -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="batchYear" class="form-label">Batch Year</label>
                        <select class="form-select" id="batchYear" name="batchYear">
                            <option value="">All</option>
                            @if (ViewBag.AvailableBatchYears != null)
                            {
                                foreach (var year in (List<string>)ViewBag.AvailableBatchYears)
                                {
                                    var isSelected = year == ViewBag.CurrentBatchYear as string;
                                    <option value="@year" selected="@isSelected">@year</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Enrollment Date Range -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="enrollmentDateFrom" class="form-label">Enrollment Date From</label>
                        <input type="date" class="form-control" id="enrollmentDateFrom" name="enrollmentDateFrom" />
                    </div>
                    <div class="col-12 col-md-6 col-lg-4">
                        <label for="enrollmentDateTo" class="form-label">Enrollment Date To</label>
                        <input type="date" class="form-control" id="enrollmentDateTo" name="enrollmentDateTo" />
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                        </svg>
                        Generate Report
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="resetForm()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
                        </svg>
                        Reset Filters
                    </button>
                </div>
            </form>
            
            <div class="mt-3 pt-3 border-top">
                <form asp-action="GenerateAnnualPerformanceReport" method="post">
                    <button type="submit" class="btn btn-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-spreadsheet" viewBox="0 0 16 16">
                            <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5zM3 12v-2h2v2zm0 1h2v2H4a1 1 0 0 1-1-1zm3 2v-2h3v2zm4 0v-2h3v1a1 1 0 0 1-1 1zm3-3h-3v-2h3zm-7 0v-2h3v2z"/>
                        </svg>
                        Annual Performance Report
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Report Information</h5>
        </div>
        <div class="card-body">
            <p class="mb-2"><strong>Available Data Fields:</strong></p>
            <ul class="mb-0">
                <li>Case Number, Name (First, Middle, Last)</li>
                <li>Contact Information (Email, Phone)</li>
                <li>Demographics (Date of Birth, Gender, Ethnicity, Hispanic/Latino)</li>
                <li>Program Information (Eligibility, Enrollment Date, Expected Graduation)</li>
                <li>Academic Information (GPA, Total Credits, Credits This Semester)</li>
                <li>Classes (Number of enrolled classes)</li>
                <li>Created By (User who added the student)</li>
            </ul>
            <p class="mt-3 mb-0"><strong>Note:</strong> CSV format includes all fields and is suitable for Excel. PDF format includes summary information in a formatted table.</p>
        </div>
    </div>
        </div>

        <!-- Dashboards Tab -->
        <div class="tab-pane fade" id="dashboards" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Database Query Dashboard</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Info:</strong> Write SQL queries to explore the database. Use the table reference below for available tables and columns.
                    </div>

                    <form id="queryForm" asp-action="ExecuteQuery" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="sqlQuery" class="form-label fw-bold">SQL Query</label>
                            <textarea class="form-control" id="sqlQuery" name="sqlQuery" rows="6" 
                                      placeholder="SELECT * FROM Students WHERE Grade = '5th' LIMIT 10">@(ViewBag.SqlQuery ?? "")</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-play-fill" viewBox="0 0 16 16">
                                <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393"/>
                            </svg>
                            Execute Query
                        </button>
                    </form>

                    @if (ViewBag.QueryResults != null)
                    {
                        <div class="mt-4">
                            <h5>Query Results</h5>
                            @if (ViewBag.ExecutedSqlQuery != null)
                            {
                                <div class="alert alert-secondary py-2">
                                    <strong>Executed SQL:</strong>
                                    <code>@ViewBag.ExecutedSqlQuery</code>
                                </div>
                            }
                            <div class="table-responsive">
                                @Html.Raw(ViewBag.QueryResults)
                            </div>
                        </div>
                    }

                    @if (ViewBag.QueryError != null)
                    {
                        <div class="alert alert-danger mt-4">
                            <strong>Error:</strong> @ViewBag.QueryError
                        </div>
                    }
                </div>
            </div>

            <!-- Database Schema Information -->
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <button class="btn btn-link text-white text-decoration-none w-100 text-start p-0" type="button" data-bs-toggle="collapse" data-bs-target="#tableReferenceCollapse" aria-expanded="false" aria-controls="tableReferenceCollapse">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-down me-2" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"/>
                            </svg>
                            Database Tables Reference
                        </button>
                    </h5>
                </div>
                <div id="tableReferenceCollapse" class="collapse">
                <div class="card-body">
                    <div class="accordion" id="schemaAccordion">
                        <!-- Students Table -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingStudents">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStudents">
                                    <strong>Students</strong> - Student records with demographics and program information
                                </button>
                            </h2>
                            <div id="collapseStudents" class="accordion-collapse collapse" data-bs-parent="#schemaAccordion">
                                <div class="accordion-body">
                                    <code>Id, CaseNumber, FirstName, MiddleName, LastName, Email, PhoneNumber, DateOfBirth, Gender, Ethnicity, HispanicLatino, Eligibility, FirstEnrollmentDate, ExpectedGraduationDate, AcademicStanding, GPA, TotalCredits, CreditsThisSemester, BatchYear, CreatedByUserId</code>
                                </div>
                            </div>
                        </div>

                        <!-- AspNetUsers Table -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingUsers">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUsers">
                                    <strong>AspNetUsers</strong> - User accounts (Admins, Directors, Tutors)
                                </button>
                            </h2>
                            <div id="collapseUsers" class="accordion-collapse collapse" data-bs-parent="#schemaAccordion">
                                <div class="accordion-body">
                                    <code>Id, UserName, Email, FirstName, LastName, PhoneNumber, EmailConfirmed, Primary</code>
                                </div>
                            </div>
                        </div>

                        <!-- StudentClasses Table -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingClasses">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseClasses">
                                    <strong>StudentClasses</strong> - Student class enrollments
                                </button>
                            </h2>
                            <div id="collapseClasses" class="accordion-collapse collapse" data-bs-parent="#schemaAccordion">
                                <div class="accordion-body">
                                    <code>Id, StudentId, ClassName, ClassDescription, Semester, Year</code>
                                </div>
                            </div>
                        </div>

                        <!-- TutoringNotes Table -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingNotes">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNotes">
                                    <strong>TutoringNotes</strong> - Tutoring session notes
                                </button>
                            </h2>
                            <div id="collapseNotes" class="accordion-collapse collapse" data-bs-parent="#schemaAccordion">
                                <div class="accordion-body">
                                    <code>Id, StudentId, TutorId, NoteDate, NoteText, SessionDuration</code>
                                </div>
                            </div>
                        </div>

                        <!-- DirectorsPageInfos Table -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingDirectors">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDirectors">
                                    <strong>DirectorsPageInfos</strong> - School and grant information
                                </button>
                            </h2>
                            <div id="collapseDirectors" class="accordion-collapse collapse" data-bs-parent="#schemaAccordion">
                                <div class="accordion-body">
                                    <code>Id, BatchYear, SchoolName, Address, SchoolPhone, DirectorName, DirectorEmail, DirectorPhone, GrantType, PRAwardNumber, GrantBudget</code>
                                </div>
                            </div>
                        </div>

                        <!-- AuditLogs Table -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingAudit">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAudit">
                                    <strong>AuditLogs</strong> - System audit trail
                                </button>
                            </h2>
                            <div id="collapseAudit" class="accordion-collapse collapse" data-bs-parent="#schemaAccordion">
                                <div class="accordion-body">
                                    <code>Id, Timestamp, UserId, UserName, Action, EntityType, EntityId, Details</code>
                                </div>
                            </div>
                        </div>

                        <!-- RolePermissions Table -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingPermissions">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePermissions">
                                    <strong>RolePermissions</strong> - Role-based permissions
                                </button>
                            </h2>
                            <div id="collapsePermissions" class="accordion-collapse collapse" data-bs-parent="#schemaAccordion">
                                <div class="accordion-body">
                                    <code>Id, RoleName, CanDeleteStudents, CanDeleteAdmins, CanDeleteDirectors, CanDeleteTutors, CanEditAdmins, CanEditDirectors, CanEditTutors, CanManageAdmins</code>
                                </div>
                            </div>
                        </div>

                        <!-- AspNetRoles Table -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingRoles">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRoles">
                                    <strong>AspNetRoles</strong> - System roles
                                </button>
                            </h2>
                            <div id="collapseRoles" class="accordion-collapse collapse" data-bs-parent="#schemaAccordion">
                                <div class="accordion-body">
                                    <code>Id, Name, NormalizedName</code>
                                    <p class="mt-2 mb-0"><strong>Available Roles:</strong> Admin, Director, Tutor, Student</p>
                                </div>
                            </div>
                        </div>

                        <!-- AspNetUserRoles Table -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingUserRoles">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUserRoles">
                                    <strong>AspNetUserRoles</strong> - User role assignments
                                </button>
                            </h2>
                            <div id="collapseUserRoles" class="accordion-collapse collapse" data-bs-parent="#schemaAccordion">
                                <div class="accordion-body">
                                    <code>UserId, RoleId</code>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 alert alert-warning">
                        <strong>Query Examples:</strong>
                        <ul class="mb-0">
                            <li><code>SELECT * FROM Students WHERE Grade = '5th' LIMIT 10</code></li>
                            <li><code>SELECT FirstName, LastName, Email FROM AspNetUsers</code></li>
                            <li><code>SELECT COUNT(*) as TotalStudents FROM Students</code></li>
                            <li><code>SELECT AcademicStanding, COUNT(*) as Count FROM Students GROUP BY AcademicStanding</code></li>
                            <li><code>SELECT s.FirstName, s.LastName, u.Email as CreatedBy FROM Students s LEFT JOIN AspNetUsers u ON s.CreatedByUserId = u.Id</code></li>
                        </ul>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-label {
        font-weight: 600;
        color: #495057;
    }
    
    .card-header h4,
    .card-header h5 {
        font-size: 1.25rem;
    }
</style>

<script>
    function resetForm() {
        document.getElementById('reportForm').reset();
    }

    // Persist active tab across page reloads
    document.addEventListener('DOMContentLoaded', function() {
        // Check if we should show the dashboards tab (when there are query results or errors)
        var hasQueryResults = @(ViewBag.QueryResults != null ? "true" : "false");
        var hasQueryError = @(ViewBag.QueryError != null ? "true" : "false");
        
        if (hasQueryResults || hasQueryError) {
            // Switch to dashboards tab
            var dashboardsTab = document.getElementById('dashboards-tab');
            var dashboardsPane = document.getElementById('dashboards');
            var reportsTab = document.getElementById('generate-reports-tab');
            var reportsPane = document.getElementById('generate-reports');
            
            reportsTab.classList.remove('active');
            reportsPane.classList.remove('show', 'active');
            dashboardsTab.classList.add('active');
            dashboardsPane.classList.add('show', 'active');
        }
    });
</script>
