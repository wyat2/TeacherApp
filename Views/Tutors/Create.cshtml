@{
    ViewData["Title"] = "Create Tutor";
}

<h2>Create Tutor</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Email @if (ViewData.ModelState["email"]?.Errors.Count > 0) { <span class="text-danger fw-bold">*</span> }</label>
        <input name="email" type="email" class="form-control @(ViewData.ModelState["email"]?.Errors.Count > 0 ? "is-invalid" : "")" value="@ViewBag.Email" required />
    </div>
    <div class="mb-3">
        <label>First Name</label>
        <input name="firstName" class="form-control" value="@ViewBag.FirstName" />
    </div>
    <div class="mb-3">
        <label>Last Name</label>
        <input name="lastName" class="form-control" value="@ViewBag.LastName" />
    </div>
    <div class="mb-3">
        <label>Password @if (ViewData.ModelState["password"]?.Errors.Count > 0) { <span class="text-danger fw-bold">*</span> }</label>
        <input name="password" type="password" class="form-control @(ViewData.ModelState["password"]?.Errors.Count > 0 ? "is-invalid" : "")" required />
    </div>
    <div class="mb-3">
        <label>Telephone</label>
        <input name="phoneNumber" type="tel" class="form-control" value="@ViewBag.PhoneNumber" />
    </div>
    <button class="btn btn-primary">Create Tutor</button>
</form>
