@model IEnumerable<TeacherApp.Models.Student>
@{
    ViewData["Title"] = "Students";
}

<h2>Students</h2>
<form method="get" class="mb-3 row g-2">
  <div class="col-auto">
    <input name="q" value="@ViewBag.Query" placeholder="Search name or email" class="form-control" />
  </div>
  <div class="col-auto">
    <button class="btn btn-outline-primary" type="submit">Search</button>
    <a class="btn btn-outline-secondary ms-1" href="/Students">Clear</a>
    <a class="btn btn-outline-info ms-1" href="/Students?showAll=true">All</a>
  </div>
</form>
<p>
  <a class="btn btn-primary" href="/Students/Create">Add Student</a>
  <a class="btn btn-secondary ms-2" href="/Students/ExportCsv?q=@ViewBag.Query">Export CSV</a>
</p>

@if (ViewBag.IsSearch == true || ViewBag.IsStandingFilter == true || ViewBag.IsGpaRangeFilter == true || ViewBag.ShowAll == true)
{
    <!-- Student List View (shown during search or standing filter) -->
    @if (ViewBag.ShowAll == true)
    {
        <div class="alert alert-info">
            <span>Showing <strong>all students</strong> (all batch years)</span>
            <a href="/Students" class="btn btn-sm btn-outline-secondary ms-2">Show Current Batch Year Only</a>
        </div>
    }
    else if (ViewBag.IsStandingFilter == true || ViewBag.IsGpaRangeFilter == true)
    {
        <div class="alert alert-info">
            @if (ViewBag.IsGpaRangeFilter == true)
            {
                <span>Showing <strong>@ViewBag.Standing</strong> students with GPA <strong>@ViewBag.GpaRange</strong></span>
            }
            else
            {
                <span>Showing students with Academic Standing: <strong>@ViewBag.Standing</strong></span>
            }
            <a href="/Students" class="btn btn-sm btn-outline-secondary ms-2">Show All</a>
        </div>
    }
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Case Number</th>
                <th>Academic Standing</th>
                <th>Cumulative GPA</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@(s.FirstName) @(string.IsNullOrEmpty(s.MiddleInitial) ? "" : s.MiddleInitial + ". ")@(s.LastName)</td>
                    <td>@s.CaseNumber</td>
                    <td>@(string.IsNullOrEmpty(s.AcademicStanding) ? "-" : s.AcademicStanding)</td>
                    <td>@(s.CumulativeGPA.HasValue ? s.CumulativeGPA.Value.ToString("F2") : "-")</td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@s.Id">Details</a>
                        @if (ViewBag.CanDeleteStudents == true)
                        {
                            <button type="button" class="btn btn-sm btn-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@s.Id" data-name="@($"{s.FirstName} {s.LastName}")">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <!-- Academic Standing Histogram View (default) -->
    <div class="row g-3">
        @{
            var histogramData = ViewBag.HistogramData as Dictionary<string, Dictionary<string, int>>;
            var totalsByStanding = ViewBag.TotalStudentsByStanding as Dictionary<string, int>;
            var colors = new Dictionary<string, string>
            {
                { "Freshman", "primary" },
                { "Sophomore", "success" },
                { "Junior", "warning" },
                { "Senior", "danger" },
                { "Graduate Student", "info" }
            };
        }
        
        @if (histogramData != null && totalsByStanding != null)
        {
            foreach (var standing in histogramData.Keys)
            {
                var gpaData = histogramData[standing];
                var total = totalsByStanding[standing];
                var maxCount = gpaData.Values.Max();
                var color = colors.ContainsKey(standing) ? colors[standing] : "secondary";
                
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow-sm">
                        <a href="/Students?standing=@System.Uri.EscapeDataString(standing)" class="text-decoration-none">
                            <div class="card-header bg-@color text-white" style="cursor: pointer;">
                                <h5 class="mb-0">@standing</h5>
                                <small>Total: @total students</small>
                            </div>
                        </a>
                        <div class="card-body">
                            <h6 class="text-muted mb-3">GPA Distribution</h6>
                            @foreach (var gpaRange in gpaData.OrderBy(x => x.Key))
                            {
                                var count = gpaRange.Value;
                                var percentage = total > 0 ? (count * 100.0 / total) : 0;
                                var barWidth = maxCount > 0 ? (count * 100.0 / maxCount) : 0;
                                var filterUrl = $"/Students?standing={System.Uri.EscapeDataString(standing)}&gpaRange={System.Uri.EscapeDataString(gpaRange.Key)}";
                                
                                <a href="@filterUrl" class="text-decoration-none" style="color: inherit;">
                                    <div class="mb-2" style="cursor: pointer; transition: background-color 0.2s; padding: 5px; border-radius: 4px;" onmouseover="this.style.backgroundColor='#f8f9fa'" onmouseout="this.style.backgroundColor='transparent'">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <small class="text-muted">@gpaRange.Key</small>
                                            <small><strong>@count</strong> (@percentage.ToString("F1")%)</small>
                                        </div>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar bg-@color" role="progressbar" style="width: @barWidth%" aria-valuenow="@count" aria-valuemin="0" aria-valuemax="@maxCount">
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

@if (ViewBag.CanDeleteStudents == true)
{
    <!-- Delete confirmation modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="deleteModalLabel">Confirm delete</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form id="deleteForm" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteId" />
            <div class="modal-body">
              Are you sure you want to delete <strong id="deleteName"></strong>?
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-danger">Delete</button>
            </div>
          </form>
        </div>
      </div>
    </div>
}

<script>
    var deleteModal = document.getElementById('deleteModal');
    if (deleteModal) {
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteName').textContent = name;
        });
    }
</script>
