@model TeacherApp.Models.StudentClass
@{
    ViewData["Title"] = "Tutoring Notes";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <h2 class="mb-2 mb-md-0">Tutoring Notes - @(Model.Student?.FirstName ?? "") @(Model.Student?.LastName ?? "")</h2>
        <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.StudentId">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
            </svg>
            Back
        </a>
    </div>

    <!-- Class Information -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Class Information</h4>
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <strong>Student:</strong> @Model.Student?.FirstName @Model.Student?.LastName
                </div>
                <div class="col-12 col-md-6">
                    <strong>Class Name:</strong> @(string.IsNullOrEmpty(Model.ClassName) ? "-" : Model.ClassName)
                </div>
                <div class="col-12 col-md-6">
                    <strong>Instructor:</strong> @(string.IsNullOrEmpty(Model.Instructor) ? "-" : Model.Instructor)
                </div>
                <div class="col-12 col-md-6">
                    <strong>Schedule:</strong> @(string.IsNullOrEmpty(Model.Schedule) ? "-" : Model.Schedule)
                </div>
                <div class="col-12 col-md-6">
                    <strong>Semester:</strong> @(string.IsNullOrEmpty(Model.Semester) ? "-" : Model.Semester)
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation tabs -->
    <ul class="nav nav-tabs mb-3" id="tutoringTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes" type="button" role="tab">Tutoring Notes</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tests-homework-tab" data-bs-toggle="tab" data-bs-target="#tests-homework" type="button" role="tab">Tests & Homework</button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Tutoring Notes Tab -->
        <div class="tab-pane fade show active" id="notes" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Tutoring Notes</h4>
                </div>
                <div class="card-body">
                    <!-- Add New Note Form -->
                    <form id="addNoteForm" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="studentClassId" value="@Model.Id" />
                        <div class="row g-2">
                            <div class="col-12 col-md-3">
                                <label for="noteDate" class="form-label">Date *</label>
                                <input type="date" class="form-control form-control-sm" id="noteDate" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-12 col-md-9">
                                <label for="noteText" class="form-label">Notes *</label>
                                <textarea class="form-control form-control-sm" id="noteText" rows="2" required placeholder="Enter tutoring notes..."></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
                                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                                    </svg>
                                    Add Note
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Previous Notes -->
                    <hr />
                    <h5 class="mb-3">Previous Notes</h5>
                    @if (Model.TutoringNotes != null && Model.TutoringNotes.Any())
                    {
                        <div class="list-group">
                            @foreach (var note in Model.TutoringNotes.OrderByDescending(n => n.NoteDate).ThenByDescending(n => n.CreatedAt))
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="mb-1">@note.NoteDate.ToString("MMMM dd, yyyy")</h6>
                                            <small class="text-muted">
                                                Created by: @(note.CreatedByUser?.Email ?? "Unknown") | 
                                                @note.CreatedAt.ToString("MMM dd, yyyy h:mm tt")
                                            </small>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteNote(@note.Id)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                            </svg>
                                        </button>
                                    </div>
                                    <p class="mb-0">@note.Notes</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            No tutoring notes have been added yet.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Tests & Homework Tab -->
        <div class="tab-pane fade" id="tests-homework" role="tabpanel">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Tests & Homework</h4>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Add Homework Section -->
                <div class="col-12 col-lg-6">
                    <h6 class="mb-2">Add Homework</h6>
                    <form id="addHomeworkForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="homeworkClassId" value="@Model.Id" />
                        <input type="hidden" id="editHomeworkId" value="" />
                        <div class="mb-2">
                            <label for="homeworkName" class="form-label form-label-sm">Homework Name *</label>
                            <input type="text" class="form-control form-control-sm" id="homeworkName" required placeholder="e.g., Chapter 5 Problems" />
                        </div>
                        <div class="mb-2">
                            <label for="homeworkDate" class="form-label form-label-sm">Date *</label>
                            <input type="date" class="form-control form-control-sm" id="homeworkDate" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mb-2">
                            <label for="homeworkScore" class="form-label form-label-sm">Score</label>
                            <input type="text" class="form-control form-control-sm" id="homeworkScore" placeholder="e.g., 95/100 or A" />
                        </div>
                        <button type="submit" class="btn btn-warning btn-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                            </svg>
                            <span id="homeworkBtnText">Add Homework</span>
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" id="cancelHomeworkEdit" style="display:none;" onclick="cancelHomeworkEdit()">Cancel</button>
                    </form>
                </div>

                <!-- Add Test Section -->
                <div class="col-12 col-lg-6">
                    <h6 class="mb-2">Add Test</h6>
                    <form id="addTestForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="testClassId" value="@Model.Id" />
                        <input type="hidden" id="editTestId" value="" />
                        <div class="mb-2">
                            <label for="testName" class="form-label form-label-sm">Test Name *</label>
                            <input type="text" class="form-control form-control-sm" id="testName" required placeholder="e.g., Midterm Exam" />
                        </div>
                        <div class="mb-2">
                            <label for="testDate" class="form-label form-label-sm">Date *</label>
                            <input type="date" class="form-control form-control-sm" id="testDate" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mb-2">
                            <label for="testScore" class="form-label form-label-sm">Score</label>
                            <input type="text" class="form-control form-control-sm" id="testScore" placeholder="e.g., 88/100 or B+" />
                        </div>
                        <button type="submit" class="btn btn-warning btn-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                            </svg>
                            <span id="testBtnText">Add Test</span>
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" id="cancelTestEdit" style="display:none;" onclick="cancelTestEdit()">Cancel</button>
                    </form>
                </div>
            </div>

            <!-- Display Homework List -->
            <div class="mt-3">
                <h6 class="mb-2">Homework Assignments</h6>
                @if (Model.Homework != null && Model.Homework.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Date</th>
                                    <th>Score</th>
                                    <th>Added By</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var hw in Model.Homework.OrderByDescending(h => h.Date))
                                {
                                    <tr>
                                        <td>@hw.Name</td>
                                        <td>@hw.Date.ToString("MMM dd, yyyy")</td>
                                        <td>@(string.IsNullOrEmpty(hw.Score) ? "-" : hw.Score)</td>
                                        <td><small>@(hw.CreatedByUser?.Email ?? "Unknown")</small></td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary" onclick='editHomework(@hw.Id, @Json.Serialize(hw.Name), "@hw.Date.ToString("yyyy-MM-dd")", @Json.Serialize(hw.Score))'>
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                </svg>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteHomework(@hw.Id)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        No homework assignments have been added yet.
                    </div>
                }
            </div>

            <!-- Display Tests List -->
            <div class="mt-3">
                <h6 class="mb-2">Tests</h6>
                @if (Model.Tests != null && Model.Tests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Date</th>
                                    <th>Score</th>
                                    <th>Added By</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var test in Model.Tests.OrderByDescending(t => t.Date))
                                {
                                    <tr>
                                        <td>@test.Name</td>
                                        <td>@test.Date.ToString("MMM dd, yyyy")</td>
                                        <td>@(string.IsNullOrEmpty(test.Score) ? "-" : test.Score)</td>
                                        <td><small>@(test.CreatedByUser?.Email ?? "Unknown")</small></td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary" onclick='editTest(@test.Id, @Json.Serialize(test.Name), "@test.Date.ToString("yyyy-MM-dd")", @Json.Serialize(test.Score))'>
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                </svg>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteTest(@test.Id)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        No tests have been added yet.
                    </div>
                }
            </div>
        </div>
    </div>
        </div>
    </div>
</div>

<script>
    // Add note form submission
    document.getElementById('addNoteForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const studentClassId = document.getElementById('studentClassId').value;
        const noteDate = document.getElementById('noteDate').value;
        const notes = document.getElementById('noteText').value;
        
        if (!notes.trim()) {
            alert('Please enter notes');
            return;
        }
        
        const data = {
            StudentClassId: parseInt(studentClassId),
            NoteDate: noteDate,
            Notes: notes
        };
        
        console.log('Submitting tutoring note:', data);
        
        fetch('/Students/AddTutoringNote', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
        })
        .then(response => {
            console.log('Response status:', response.status);
            return response.json();
        })
        .then(result => {
            console.log('Result:', result);
            if (result.success) {
                sessionStorage.setItem('activeTutoringTab', 'notes');
                location.reload();
            } else {
                alert('Error adding note: ' + result.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error adding note: ' + error.message);
        });
    });
    
    // Delete note
    function deleteNote(noteId) {
        if (confirm('Are you sure you want to delete this note?')) {
            fetch('/Students/DeleteTutoringNote/' + noteId, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error deleting note: ' + result.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting note');
            });
        }
    }

    // Add homework form submission
    document.getElementById('addHomeworkForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const studentClassId = document.getElementById('homeworkClassId').value;
        const editId = document.getElementById('editHomeworkId').value;
        const name = document.getElementById('homeworkName').value;
        const date = document.getElementById('homeworkDate').value;
        const score = document.getElementById('homeworkScore').value;
        
        if (!name.trim()) {
            alert('Please enter homework name');
            return;
        }
        
        const data = {
            StudentClassId: parseInt(studentClassId),
            Name: name,
            Date: date,
            Score: score || null
        };

        // If editing, add the ID
        if (editId) {
            data.Id = parseInt(editId);
        }
        
        const url = editId ? '/Students/UpdateHomework' : '/Students/AddHomework';
        
        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                sessionStorage.setItem('activeTutoringTab', 'tests-homework');
                location.reload();
            } else {
                alert('Error saving homework: ' + result.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error saving homework');
        });
    });

    // Add test form submission
    document.getElementById('addTestForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const studentClassId = document.getElementById('testClassId').value;
        const editId = document.getElementById('editTestId').value;
        const name = document.getElementById('testName').value;
        const date = document.getElementById('testDate').value;
        const score = document.getElementById('testScore').value;
        
        if (!name.trim()) {
            alert('Please enter test name');
            return;
        }
        
        const data = {
            StudentClassId: parseInt(studentClassId),
            Name: name,
            Date: date,
            Score: score || null
        };

        // If editing, add the ID
        if (editId) {
            data.Id = parseInt(editId);
        }
        
        const url = editId ? '/Students/UpdateTest' : '/Students/AddTest';
        
        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                sessionStorage.setItem('activeTutoringTab', 'tests-homework');
                location.reload();
            } else {
                alert('Error saving test: ' + result.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error saving test');
        });
    });

    // Edit homework
    function editHomework(id, name, date, score) {
        document.getElementById('editHomeworkId').value = id;
        document.getElementById('homeworkName').value = name;
        document.getElementById('homeworkDate').value = date;
        document.getElementById('homeworkScore').value = score || '';
        document.getElementById('homeworkBtnText').textContent = 'Update Homework';
        document.getElementById('cancelHomeworkEdit').style.display = 'inline-block';
        // Scroll to form
        document.getElementById('addHomeworkForm').scrollIntoView({ behavior: 'smooth' });
    }

    // Cancel homework edit
    function cancelHomeworkEdit() {
        document.getElementById('editHomeworkId').value = '';
        document.getElementById('homeworkName').value = '';
        document.getElementById('homeworkDate').value = '@DateTime.Now.ToString("yyyy-MM-dd")';
        document.getElementById('homeworkScore').value = '';
        document.getElementById('homeworkBtnText').textContent = 'Add Homework';
        document.getElementById('cancelHomeworkEdit').style.display = 'none';
    }

    // Edit test
    function editTest(id, name, date, score) {
        document.getElementById('editTestId').value = id;
        document.getElementById('testName').value = name;
        document.getElementById('testDate').value = date;
        document.getElementById('testScore').value = score || '';
        document.getElementById('testBtnText').textContent = 'Update Test';
        document.getElementById('cancelTestEdit').style.display = 'inline-block';
        // Scroll to form
        document.getElementById('addTestForm').scrollIntoView({ behavior: 'smooth' });
    }

    // Cancel test edit
    function cancelTestEdit() {
        document.getElementById('editTestId').value = '';
        document.getElementById('testName').value = '';
        document.getElementById('testDate').value = '@DateTime.Now.ToString("yyyy-MM-dd")';
        document.getElementById('testScore').value = '';
        document.getElementById('testBtnText').textContent = 'Add Test';
        document.getElementById('cancelTestEdit').style.display = 'none';
    }

    // Delete homework
    function deleteHomework(homeworkId) {
        if (confirm('Are you sure you want to delete this homework?')) {
            fetch('/Students/DeleteHomework/' + homeworkId, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error deleting homework: ' + result.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting homework');
            });
        }
    }

    // Delete test
    function deleteTest(testId) {
        if (confirm('Are you sure you want to delete this test?')) {
            fetch('/Students/DeleteTest/' + testId, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error deleting test: ' + result.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting test');
            });
        }
    }

    // Restore active tab on page load
    document.addEventListener('DOMContentLoaded', function() {
        const activeTab = sessionStorage.getItem('activeTutoringTab');
        if (activeTab) {
            // Remove active classes from default tab
            document.getElementById('notes-tab').classList.remove('active');
            document.getElementById('notes').classList.remove('show', 'active');
            
            // Activate the stored tab
            if (activeTab === 'tests-homework') {
                document.getElementById('tests-homework-tab').classList.add('active');
                document.getElementById('tests-homework').classList.add('show', 'active');
            } else {
                document.getElementById('notes-tab').classList.add('active');
                document.getElementById('notes').classList.add('show', 'active');
            }
            
            // Clear the stored tab
            sessionStorage.removeItem('activeTutoringTab');
        }
    });
</script>
