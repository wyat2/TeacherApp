@model TeacherApp.Models.Student
@{
    ViewData["Title"] = "Student Details";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <h2 class="mb-2 mb-md-0">Student Details</h2>
        <div>
            <a class="btn btn-primary me-2" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-secondary" asp-action="Index">Back to List</a>
        </div>
    </div>

    <!-- Basic Information Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Basic Information</h4>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-auto">
                    @if (Model.ProfilePicture != null && Model.ProfilePicture.Length > 0)
                    {
                        <img src="@Url.Action("GetProfilePicture", "Students", new { id = Model.Id })" 
                             alt="@Model.FirstName @Model.LastName Profile Picture" 
                             class="rounded-circle img-thumbnail" 
                             style="width: 150px; height: 150px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center" 
                             style="width: 150px; height: 150px; border: 2px solid #dee2e6;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="75" height="75" fill="#6c757d" class="bi bi-person" viewBox="0 0 16 16">
                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                            </svg>
                        </div>
                    }
                </div>
                <div class="col-12 col-md">
                    <div class="row g-2">
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>First Name:<sub style="color: red; font-size: 0.7em;">(5)</sub></strong>
                                <span>@Model.FirstName</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>Middle Initial:<sub style="color: red; font-size: 0.7em;">(6)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.MiddleInitial) ? "-" : Model.MiddleInitial)</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>Last Name:<sub style="color: red; font-size: 0.7em;">(4)</sub></strong>
                                <span>@Model.LastName</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>Case Number:<sub style="color: red; font-size: 0.7em;">(3)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.CaseNumber) ? "-" : Model.CaseNumber)</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>PR/Award Number:<sub style="color: red; font-size: 0.7em;">(1)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.PRAwardNumber) ? "-" : Model.PRAwardNumber)</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>Batch Year:<sub style="color: red; font-size: 0.7em;">(2)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.BatchYear) ? "-" : Model.BatchYear)</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>Date of Birth:<sub style="color: red; font-size: 0.7em;">(7)</sub></strong>
                                <span>@(Model.DateOfBirth?.ToString("MM/dd/yyyy") ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>Gender:<sub style="color: red; font-size: 0.7em;">(8)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.Gender) ? "-" : Model.Gender)</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>Ethnicity:<sub style="color: red; font-size: 0.7em;">(9-14)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.Ethnicity) ? "-" : Model.Ethnicity)</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>Email:</strong>
                                <span>@(string.IsNullOrEmpty(Model.Email) ? "-" : Model.Email)</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="info-item">
                                <strong>Created By:</strong>
                                <span>@(Model.CreatedByUser?.Email ?? "Unknown")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabbed Content Section -->
    <div class="card shadow-sm">
        <div class="card-body">
            <ul class="nav nav-tabs" id="studentDetailsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="classes-tab" data-bs-toggle="tab" data-bs-target="#classes" type="button" role="tab" aria-controls="classes" aria-selected="true">
                        Classes
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="program-tab" data-bs-toggle="tab" data-bs-target="#program" type="button" role="tab" aria-controls="program" aria-selected="false">
                        Program Info
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="academic-tab" data-bs-toggle="tab" data-bs-target="#academic" type="button" role="tab" aria-controls="academic" aria-selected="false">
                        Academic Info
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="completion-tab" data-bs-toggle="tab" data-bs-target="#completion" type="button" role="tab" aria-controls="completion" aria-selected="false">
                        Completion & Withdrawal
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="financial-tab" data-bs-toggle="tab" data-bs-target="#financial" type="button" role="tab" aria-controls="financial" aria-selected="false">
                        Financial Info
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="other-tab" data-bs-toggle="tab" data-bs-target="#other" type="button" role="tab" aria-controls="other" aria-selected="false">
                        Other Info
                    </button>
                </li>
            </ul>
            
            <div class="tab-content pt-3" id="studentDetailsTabContent">
                <!-- Classes Tab -->
                <div class="tab-pane fade show active" id="classes" role="tabpanel" aria-labelledby="classes-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Enrolled Classes</h5>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addClassModal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                            </svg>
                            Add Class
                        </button>
                    </div>
                    @if (Model.StudentClasses != null && Model.StudentClasses.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Class Name</th>
                                        <th>Instructor</th>
                                        <th>Schedule</th>
                                        <th>Semester</th>
                                        <th>Grade</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var studentClass in Model.StudentClasses)
                                    {
                                        <tr>
                                            <td>@studentClass.ClassName</td>
                                            <td>@(string.IsNullOrEmpty(studentClass.Instructor) ? "-" : studentClass.Instructor)</td>
                                            <td>@(string.IsNullOrEmpty(studentClass.Schedule) ? "-" : studentClass.Schedule)</td>
                                            <td>@(string.IsNullOrEmpty(studentClass.Semester) ? "-" : studentClass.Semester)</td>
                                            <td>@(string.IsNullOrEmpty(studentClass.Grade) ? "-" : studentClass.Grade)</td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-warning" onclick="editClass(@studentClass.Id, '@studentClass.ClassName', '@studentClass.Instructor', '@studentClass.Schedule', '@studentClass.Semester', '@studentClass.Grade')">Edit</button>
                                                <a href="@Url.Action("Tutoring", "Students", new { classId = studentClass.Id })" class="btn btn-sm btn-info">Tutoring</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No classes enrolled yet. Click "Add Class" to add a class.
                        </div>
                    }
                </div>

                <!-- Program Information Tab -->
                <div class="tab-pane fade" id="program" role="tabpanel" aria-labelledby="program-tab">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Eligibility:<sub style="color: red; font-size: 0.7em;">(15a)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.Eligibility) ? "-" : Model.Eligibility)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Student Disability:<sub style="color: red; font-size: 0.7em;">(15b)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.StudentDisability) ? "-" : Model.StudentDisability)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Academic Need:<sub style="color: red; font-size: 0.7em;">(16)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.AcademicNeed) ? "-" : Model.AcademicNeed)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>First Enrollment Date:<sub style="color: red; font-size: 0.7em;">(17)</sub></strong>
                                <span>@(Model.FirstEnrollmentDate?.ToString("MM/dd/yyyy") ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Date of First Project Service:<sub style="color: red; font-size: 0.7em;">(18)</sub></strong>
                                <span>@(Model.DateOfFirstProjectService?.ToString("MM/dd/yyyy") ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Student's Cohort Year:<sub style="color: red; font-size: 0.7em;">(21)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.StudentCohortYear) ? "-" : Model.StudentCohortYear)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Academic Information Tab -->
                <div class="tab-pane fade" id="academic" role="tabpanel" aria-labelledby="academic-tab">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>College Grade Level <sub>(Entry into Project)</sub>:<sub style="color: red; font-size: 0.7em;">(19)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.CollegeGradeLevelEntryIntoProject) ? "-" : Model.CollegeGradeLevelEntryIntoProject)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>College Grade Level <sub>(Beginning of Academic Year)</sub>:<sub style="color: red; font-size: 0.7em;">(26)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.CollegeGradeLevelAtBeginningOfAcademicYear) ? "-" : Model.CollegeGradeLevelAtBeginningOfAcademicYear)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>College Grade Level <sub>(End of Academic Year)</sub>:<sub style="color: red; font-size: 0.7em;">(27)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.CollegeGradeLevelAtEndOfAcademicYear) ? "-" : Model.CollegeGradeLevelAtEndOfAcademicYear)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Enrollment Status <sub>(Academic Year First Served)</sub>:<sub style="color: red; font-size: 0.7em;">(20)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.EnrollmentStatusInAcademicYearFirstServed) ? "-" : Model.EnrollmentStatusInAcademicYearFirstServed)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Enrollment Status <sub>(End of Academic Year)</sub>:<sub style="color: red; font-size: 0.7em;">(23)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.EnrollmentStatusAtEndOfAcademicYear) ? "-" : Model.EnrollmentStatusAtEndOfAcademicYear)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Participant Status <sub>(Academic Year Being Reported)</sub>:<sub style="color: red; font-size: 0.7em;">(22)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.ParticipantStatusDuringAcademicYearBeingReported) ? "-" : Model.ParticipantStatusDuringAcademicYearBeingReported)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Academic Standing:<sub style="color: red; font-size: 0.7em;">(24)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.AcademicStanding) ? "-" : Model.AcademicStanding)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Cumulative GPA:<sub style="color: red; font-size: 0.7em;">(25)</sub></strong>
                                <span>@(Model.CumulativeGPA?.ToString("F2") ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Persistence Status<sub>(Beginning of Academic Year)</sub>:<sub style="color: red; font-size: 0.7em;">(34)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.PersistenceStatusAtBeginningOfAcademicYear) ? "-" : Model.PersistenceStatusAtBeginningOfAcademicYear)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Completion & Withdrawal Tab -->
                <div class="tab-pane fade" id="completion" role="tabpanel" aria-labelledby="completion-tab">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Date of Last Project Service:<sub style="color: red; font-size: 0.7em;">(28)</sub></strong>
                                <span>@(Model.DateOfLastProjectService?.ToString("MM/dd/yyyy") ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Reason for Withdrawal or Not Returning:<sub style="color: red; font-size: 0.7em;">(29)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.ReasonForWithdrawalOrNotReturning) ? "-" : Model.ReasonForWithdrawalOrNotReturning)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Transfers:<sub style="color: red; font-size: 0.7em;">(30)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.Transfers) ? "-" : Model.Transfers)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Undergraduate Degree/Certificate Completed:<sub style="color: red; font-size: 0.7em;">(31)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.UndergraduateDegreeCertificateCompletedAtGranteeInstitution) ? "-" : Model.UndergraduateDegreeCertificateCompletedAtGranteeInstitution)</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Date of Undergraduate Degree/Certificate:<sub style="color: red; font-size: 0.7em;">(32)</sub></strong>
                                <span>@(Model.DateOfUndergraduateDegreeCertificate?.ToString("MM/dd/yyyy") ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Field of Study Degree/Certificate Earned:<sub style="color: red; font-size: 0.7em;">(33)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.FieldOfStudyDegreeCertificateEarned) ? "-" : Model.FieldOfStudyDegreeCertificateEarned)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Financial Information Tab -->
                <div class="tab-pane fade" id="financial" role="tabpanel" aria-labelledby="financial-tab">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Amount of Financial Aid Received:<sub style="color: red; font-size: 0.7em;">(35)</sub></strong>
                                <span>@(Model.AmountOfFinancialAidReceived?.ToString("C") ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="info-item">
                                <strong>Amount of SSS Grant Aid Awarded:<sub style="color: red; font-size: 0.7em;">(36)</sub></strong>
                                <span>@(Model.AmountOfSSSGrantAidAwarded?.ToString("C") ?? "-")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Other Information Tab -->
                <div class="tab-pane fade" id="other" role="tabpanel" aria-labelledby="other-tab">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="info-item">
                                <strong>Participant Name Change:<sub style="color: red; font-size: 0.7em;">(37)</sub></strong>
                                <span>@(string.IsNullOrEmpty(Model.ParticipantNameChange) ? "-" : Model.ParticipantNameChange)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Class Modal -->
<div class="modal fade" id="addClassModal" tabindex="-1" aria-labelledby="addClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addClassModalLabel">Add Class</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addClassForm">
                <div class="modal-body">
                    <input type="hidden" id="studentId" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="className" class="form-label">Class Name *</label>
                        <input type="text" class="form-control" id="className" required />
                    </div>
                    <div class="mb-3">
                        <label for="instructor" class="form-label">Instructor</label>
                        <input type="text" class="form-control" id="instructor" />
                    </div>
                    <div class="mb-3">
                        <label for="schedule" class="form-label">Schedule</label>
                        <input type="text" class="form-control" id="schedule" placeholder="e.g., MWF 10:00-11:00 AM" />
                    </div>
                    <div class="mb-3">
                        <label for="semester" class="form-label">Semester</label>
                        <input type="text" class="form-control" id="semester" placeholder="e.g., Fall 2025" />
                    </div>
                    <div class="mb-3">
                        <label for="classGrade" class="form-label">Grade</label>
                        <input type="text" class="form-control" id="classGrade" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Class</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Class Modal -->
<div class="modal fade" id="editClassModal" tabindex="-1" aria-labelledby="editClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editClassModalLabel">Edit Class</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editClassForm">
                <div class="modal-body">
                    <input type="hidden" id="editClassId" />
                    <div class="mb-3">
                        <label for="editClassName" class="form-label">Class Name *</label>
                        <input type="text" class="form-control" id="editClassName" required />
                    </div>
                    <div class="mb-3">
                        <label for="editInstructor" class="form-label">Instructor</label>
                        <input type="text" class="form-control" id="editInstructor" />
                    </div>
                    <div class="mb-3">
                        <label for="editSchedule" class="form-label">Schedule</label>
                        <input type="text" class="form-control" id="editSchedule" placeholder="e.g., MWF 10:00-11:00 AM" />
                    </div>
                    <div class="mb-3">
                        <label for="editSemester" class="form-label">Semester</label>
                        <input type="text" class="form-control" id="editSemester" placeholder="e.g., Fall 2025" />
                    </div>
                    <div class="mb-3">
                        <label for="editClassGrade" class="form-label">Grade</label>
                        <input type="text" class="form-control" id="editClassGrade" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger me-auto" onclick="deleteClassFromModal()">Delete Class</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .info-item {
        padding: 0.75rem;
        background-color: #f8f9fa;
        border-radius: 0.375rem;
        height: 100%;
    }
    
    .info-item strong {
        display: block;
        color: #495057;
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }
    
    .info-item span {
        display: block;
        color: #212529;
        font-size: 1rem;
    }
    
    .nav-tabs .nav-link {
        color: #495057;
        font-weight: 500;
    }
    
    .nav-tabs .nav-link.active {
        color: #0d6efd;
        font-weight: 600;
    }
    
    .card-header h4 {
        font-size: 1.25rem;
    }
    
    @@media (max-width: 767.98px) {
        .nav-tabs {
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
        }
        
        .nav-tabs .nav-link {
            white-space: nowrap;
        }
    }
</style>

<script>
    // Add class form submission
    document.getElementById('addClassForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const studentId = document.getElementById('studentId').value;
        const data = {
            studentId: parseInt(studentId),
            className: document.getElementById('className').value,
            instructor: document.getElementById('instructor').value,
            schedule: document.getElementById('schedule').value,
            semester: document.getElementById('semester').value,
            grade: document.getElementById('classGrade').value
        };
        
        fetch('/Students/AddClass', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                location.reload();
            } else {
                alert('Error adding class: ' + result.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error adding class');
        });
    });
    
    // Edit class
    function editClass(classId, className, instructor, schedule, semester, grade) {
        document.getElementById('editClassId').value = classId;
        document.getElementById('editClassName').value = className || '';
        document.getElementById('editInstructor').value = instructor || '';
        document.getElementById('editSchedule').value = schedule || '';
        document.getElementById('editSemester').value = semester || '';
        document.getElementById('editClassGrade').value = grade || '';
        
        var editModal = new bootstrap.Modal(document.getElementById('editClassModal'));
        editModal.show();
    }

    // Delete class from modal
    function deleteClassFromModal() {
        const classId = document.getElementById('editClassId').value;
        if (confirm('Are you sure you want to delete this class?')) {
            fetch('/Students/DeleteClass/' + classId, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error deleting class: ' + result.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting class');
            });
        }
    }

    // Edit class form submission
    document.getElementById('editClassForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const classId = document.getElementById('editClassId').value;
        const data = {
            id: parseInt(classId),
            className: document.getElementById('editClassName').value,
            instructor: document.getElementById('editInstructor').value,
            schedule: document.getElementById('editSchedule').value,
            semester: document.getElementById('editSemester').value,
            grade: document.getElementById('editClassGrade').value
        };
        
        fetch('/Students/EditClass', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                location.reload();
            } else {
                alert('Error editing class: ' + result.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error editing class');
        });
    });

    // Delete class
    function deleteClass(classId) {
        if (confirm('Are you sure you want to delete this class?')) {
            fetch('/Students/DeleteClass/' + classId, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error deleting class: ' + result.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting class');
            });
        }
    }
</script>
