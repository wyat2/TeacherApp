@model IEnumerable<TeacherApp.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs - FERPA Compliance";
}

<h2>Audit Logs</h2>
<p class="text-muted">Track all access to student records for FERPA compliance</p>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label for="userId" class="form-label">User Email</label>
                <input type="text" class="form-control" id="userId" name="userId" value="@ViewBag.UserId" placeholder="Filter by user">
            </div>
            <div class="col-md-2">
                <label for="action" class="form-label">Action</label>
                <select class="form-select" id="action" name="action">
                    <option value="">All Actions</option>
                    <option value="View" selected="@(ViewBag.Action == "View")">View</option>
                    <option value="Create" selected="@(ViewBag.Action == "Create")">Create</option>
                    <option value="Update" selected="@(ViewBag.Action == "Update")">Update</option>
                    <option value="Delete" selected="@(ViewBag.Action == "Delete")">Delete</option>
                    <option value="AccessEdit" selected="@(ViewBag.Action == "AccessEdit")">Access Edit</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="startDate" class="form-label">Start Date</label>
                <input type="date" class="form-control" id="startDate" name="startDate" value="@ViewBag.StartDate">
            </div>
            <div class="col-md-2">
                <label for="endDate" class="form-label">End Date</label>
                <input type="date" class="form-control" id="endDate" name="endDate" value="@ViewBag.EndDate">
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity Type</th>
                        <th>Entity ID</th>
                        <th>Details</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@log.UserEmail</td>
                                <td>
                                    <span class="badge bg-@(log.Action switch {
                                        "View" => "info",
                                        "Create" => "success",
                                        "Update" => "warning",
                                        "Delete" => "danger",
                                        "AccessEdit" => "secondary",
                                        _ => "secondary"
                                    })">
                                        @log.Action
                                    </span>
                                </td>
                                <td>@log.EntityType</td>
                                <td>
                                    @if (log.EntityId.HasValue && log.EntityType == "Student")
                                    {
                                        <a href="@Url.Action("Details", "Students", new { id = log.EntityId })">@log.EntityId</a>
                                    }
                                    else
                                    {
                                        @log.EntityId
                                    }
                                </td>
                                <td>@log.Details</td>
                                <td><small class="text-muted">@log.IpAddress</small></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No audit logs found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Count() >= 500)
        {
            <div class="alert alert-info mt-3">
                Showing most recent 500 entries. Use filters to narrow results.
            </div>
        }
    </div>
</div>
