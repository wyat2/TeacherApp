@model TeacherApp.Models.Student
@{
    ViewData["Title"] = "Delete Student";
}

<h2>Delete Student</h2>
<div class="card">
    <div class="card-body">
        <p><strong>Name:</strong> @Model.FirstName @Model.LastName</p>
        <p><strong>Class:</strong> @Model.ClassName</p>
        <p><strong>Created By:</strong> @(Model.CreatedByUser?.Email ?? "Unknown")</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a class="btn btn-secondary ms-2" asp-action="Index">Cancel</a>
</form>
