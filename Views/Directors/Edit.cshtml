@model TeacherApp.Models.ApplicationUser
@{
    ViewData["Title"] = "Edit Director";
}

<h2>Edit Director</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="row mb-2">
        <div class="col-md-5">
            <label class="form-label">First Name</label>
            <input name="firstName" value="@Model.FirstName" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label">MI</label>
            <input name="middleInitial" value="@Model.MiddleInitial" class="form-control form-control-sm" maxlength="1" />
        </div>
        <div class="col-md-5">
            <label class="form-label">Last Name</label>
            <input name="lastName" value="@Model.LastName" class="form-control form-control-sm" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <label class="form-label">Telephone</label>
            <input name="phoneNumber" value="@Model.PhoneNumber" class="form-control form-control-sm" />
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-md-6">
            <div class="form-check">
                <input type="checkbox" name="isProjectDirector" class="form-check-input" id="isProjectDirector" value="true" @(Model.IsProjectDirector ? "checked" : "") />
                <label class="form-check-label" for="isProjectDirector">Project Director</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input type="checkbox" name="isDataEntryPerson" class="form-check-input" id="isDataEntryPerson" value="true" @(Model.IsDataEntryPerson ? "checked" : "") />
                <label class="form-check-label" for="isDataEntryPerson">Data Entry Person</label>
            </div>
        </div>
    </div>
    <button class="btn btn-primary btn-sm">Save</button>
    <a class="btn btn-secondary btn-sm" href="/Directors">Cancel</a>
</form>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function(e) {
            // Add hidden fields for unchecked checkboxes
            var checkboxes = ['isProjectDirector', 'isDataEntryPerson'];
            checkboxes.forEach(function(name) {
                var checkbox = document.querySelector('input[name="' + name + '"]');
                if (!checkbox.checked) {
                    var hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = name;
                    hidden.value = 'false';
                    this.appendChild(hidden);
                }
            }.bind(this));
        });
    </script>
}
