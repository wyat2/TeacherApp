@model IEnumerable<TeacherApp.Models.ApplicationUser>
@{
    ViewData["Title"] = "Tutors";
}

<h2>Tutors</h2>
<form method="get" class="mb-3 row g-2">
    <div class="col-auto">
        <input name="q" value="@ViewBag.Query" placeholder="Search name or email" class="form-control" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Search</button>
        <a class="btn btn-outline-secondary ms-1" href="/Tutors">Clear</a>
    </div>
</form>
<p><a class="btn btn-primary" href="/Tutors/Create">Add Tutor</a></p>
<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.FirstName</td>
                <td>@u.LastName</td>
                <td>@u.Email</td>
                <td>@u.PhoneNumber</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@u.Id">Details</a>
                    @if (ViewBag.CanEdit == true)
                    {
                        <a class="btn btn-sm btn-primary ms-1" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                    }
                    @if (ViewBag.CanDelete == true)
                    {
                        <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline ms-1" onsubmit="return confirm('Are you sure you want to delete this tutor?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
