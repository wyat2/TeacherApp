@model IEnumerable<TeacherApp.Models.ApplicationUser>
@{
    ViewData["Title"] = "Admins";
    var errorMessage = TempData["ErrorMessage"] as string;
}

<h2>Admins</h2>
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="modal fade" id="selfDeleteModal" tabindex="-1" aria-labelledby="selfDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="selfDeleteModalLabel">Action Not Allowed</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @errorMessage
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>
}
<div class="mb-3">
    <a class="btn btn-primary" href="/Admins/Create">Add Admin</a>
    <a class="btn btn-secondary ms-2" asp-action="Tools">Tools</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.FirstName</td>
                <td>@u.LastName</td>
                <td>@u.Email</td>
                <td>@u.PhoneNumber</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@u.Id">Details</a>
                    @if (ViewBag.CanEdit == true)
                    {
                        <a class="btn btn-sm btn-primary ms-1" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                    }
                    @if (ViewBag.CanDelete == true)
                    {
                        <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline ms-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalElement = document.getElementById('selfDeleteModal');
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }
            });
        </script>
    }
}
